{
  "name": "vers-agent",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "bun run index.ts",
    "dev": "bun --hot run index.ts",
    "build": "bun build --compile --minify ./index.ts --outfile vers-agent",
    "build:bundle": "bun build --target=bun --minify ./index.ts --outdir=dist",
    "bundle": "bun run scripts/bundle.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.2.7"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.1.76",
    "@crosscopy/clipboard": "^0.2.8",
    "@modelcontextprotocol/sdk": "^1.25.1",
    "boxen": "^8.0.1",
    "chalk": "^5.6.2",
    "clipboard-image": "^0.1.0",
    "ink": "^6.6.0",
    "ink-multiline-input": "^0.1.0",
    "ink-text-input": "^6.0.0",
    "ora": "^9.0.0",
    "react": "^19.2.3",
    "react-devtools-core": "^7.0.1",
    "zod": "^4.3.5"
  }
}
